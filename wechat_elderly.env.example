# 微信中老年陪伴机器人 - 独立环境变量
# 复制为 wechat_elderly.env 并填写真实值
# 注意：与 QQ 机器人的 .env 完全隔离，切勿共用

# ─── LLM 配置 ─────────────────────────────────────────────────
# 建议使用与 QQ 机器人相同的 LLM 服务，但各自独立配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── WebUI 管理密码 ───────────────────────────────────────────
# 用于访问 http://服务器IP:8081 的管理界面
KIRARA_ADMIN_TOKEN=change-me-wechat-elderly

# ─── 微信接入：WeChatPadPro 个人微信（iPad 协议）───────────────
# 对应 docker-compose.yml 中的 wechatpadpro 服务

# WeChatPadPro 管理员密钥（与 docker-compose 中 ADMIN_KEY 一致）
WX_PADPRO_ADMIN_KEY=change-me-padpro-admin

# WeChatPadPro Webhook 签名密钥（与 docker-compose 中 WEBHOOK_SECRET 一致）
WX_WEBHOOK_SECRET=change-me-webhook-secret

# WeChatPadPro 数据库密码（与 docker-compose 中 WX_MYSQL_PASSWORD 一致）
WX_MYSQL_PASSWORD=weixin123
WX_MYSQL_ROOT_PASSWORD=wxroot123456

# Kirara 适配器中对应的 WeChatPadPro 服务地址（容器内通信，一般不用改）
# WX_PADPRO_BASE_URL=http://wechatpadpro:8080

# ─── 回复延迟配置（模拟真人节奏）────────────────────────────────
# 单位：毫秒，建议 2000-5000
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000

# ─── 主动问候配置（可选）─────────────────────────────────────────
# 每天最多主动发送几条问候（建议不超过2）
PROACTIVE_GREETING_MAX_PER_DAY=2
# 早安问候时间（HH:MM）
MORNING_GREETING_TIME=08:30
# 晚安问候时间（HH:MM）
EVENING_GREETING_TIME=21:00
